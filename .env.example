# Wassal - configuration
# Copier en .env / copy to .env:  cp .env.example .env

# --- Yassir ---
# Clé API partenaire Yassir (réservée à l'envoi réel des requêtes, pas encore utilisée par le MVP)
YASSIR_API_KEY=your-yassir-api-key-here

# --- Serveur Flask ---
# development = debug + auto-reload ; production = debug désactivé
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO
# Origines autorisées (CORS), séparées par des virgules. "*" = toutes
CORS_ORIGINS=*
# Taille max des uploads audio (Mo)
MAX_UPLOAD_MB=25

# --- Modèle ASR MoulSot ---
# "01Yassine/moulsot.v0.3" redirige vers ce nom canonique sur HuggingFace.
MOULSOT_MODEL=atlasia/moulsot.v0.3
# auto | cpu | cuda | mps
DEVICE=auto
# Langue passée à qwen_asr (voir les langues supportées sur la fiche du modèle)
ASR_LANGUAGE=Arabic
# true = charger le modèle au démarrage (sinon au premier audio)
PRELOAD_MODEL=false
# Durée audio max (secondes)
MAX_AUDIO_SECONDS=60
# Token HuggingFace (optionnel, seulement si le modèle devient privé/gated)
HF_TOKEN=

# --- Logique métier ---
# Confiance minimale pour ready_for_yassir=true
MIN_CONFIDENCE=0.6
# Fichier JSON des repères crowdsourcés
LANDMARKS_STORE=data/crowdsourced_landmarks.json
# Si défini, POST /wassal/landmarks exige l'en-tête X-API-Key
WASSAL_API_TOKEN=
# Vrais lieux OpenStreetMap (scripts/import_osm.py). Vide = désactivé
OSM_DATA_DIR=data/osm
